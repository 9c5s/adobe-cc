#!/bin/sh

set -e

PRESETS_SRC="${Foundation_PRESETS_INSTALL_SRC}"
PRESETS_PREFIX="$HOME/Documents/Adobe/Adobe Media Encoder"

# copy presets to all installed AME versions
if [ -d "$PRESETS_PREFIX" ]; then
    for VERSION_DIR in "$PRESETS_PREFIX"/*/; do
        if [ -d "$VERSION_DIR" ]; then
            PRESETS_DIR="$VERSION_DIR"Presets
            if [ ! -d "$PRESETS_DIR" ]; then
                mkdir "$PRESETS_DIR"
                chown "$USER" "$PRESETS_DIR"
            fi
            cp -R "$PRESETS_SRC" "$PRESETS_DIR/"
        fi
    done
fi

exit 0
