#!/bin/sh

set -e

PRESETS_SRC="${Foundation_PRESETS_INSTALL_SRC}"

# resolve the console user's home (postinstall runs as root via installer)
CONSOLE_USER=$(stat -f "%Su" /dev/console 2>/dev/null || true)
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
    exit 0
fi
CONSOLE_HOME=$(eval echo "~$CONSOLE_USER")
[ -d "$CONSOLE_HOME" ] || exit 0
PRESETS_PREFIX="$CONSOLE_HOME/Documents/Adobe/Adobe Media Encoder"

# copy presets to all installed AME versions
if [ -d "$PRESETS_PREFIX" ]; then
    for VERSION_DIR in "$PRESETS_PREFIX"/*/; do
        if [ -d "$VERSION_DIR" ]; then
            PRESETS_DIR="${VERSION_DIR}Presets"
            if [ ! -d "$PRESETS_DIR" ]; then
                mkdir "$PRESETS_DIR"
            fi
            cp -R "$PRESETS_SRC" "$PRESETS_DIR/"
            chown -R "$CONSOLE_USER" "$PRESETS_DIR"
        fi
    done
fi

exit 0
